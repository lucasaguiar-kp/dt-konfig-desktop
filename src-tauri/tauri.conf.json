{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DT Konfig",
  "version": "0.1.2",
  "identifier": "com.lucasaguiar.dtkonfigdesktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DT Konfig",
        "width": 800,
        "height": 600,
        "minWidth": 1120,
        "minHeight": 720,
        "maximized": true,
        "decorations": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "trafficLightPosition": { "x": 18, "y": 25 }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0QUI4NUExRUY3RkVEMgpSV1RTL3ZjZVdyaEtDNDRYSEpmdnNGZDRacUdpZ0ZDWkJqWmlSdjhpbkNabnkwSzhxVEp5L1RiUgo=",
      "endpoints": [
        "https://github.com/lucasaguiar-kp/dt-konfig-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
